# Absolute HTTPS deployment URL. Leave blank for non-indexable preview.
SITE_URL=
# Use /Esperanza/ for GitHub Pages; / for a domain-root deployment.
BASE_PATH=/
PUBLIC_LAUNCH_READY=false
# Approve the existing independent third-party account before enabling.
PUBLIC_BOOKING_URL=
PUBLIC_COMMUNITY_URL=
PUBLIC_FJR_URL=
# Independent JSON endpoints; never the original WordPress handler.
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_GUIDE_ENDPOINT=
# Approved, locally hosted guide files (optional).
PUBLIC_GUIDE_EN_URL=
PUBLIC_GUIDE_ES_URL=
