---
import {withBase} from '../utils/paths';
import '../styles/global.css';
import Brand from '../components/Brand.astro';
import Booking from '../components/Booking.astro';
import {config} from '../data/config';
const {title,description}=Astro.props;
const origin=import.meta.env.SITE_URL;
const ready=import.meta.env.PUBLIC_LAUNCH_READY==='true'&&!!origin;
const routePath='/' + Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/?$/, '/').length);
const canonicalPath=routePath==='/about-me/'?'/about/':routePath==='/service/'?'/services/':routePath;
const canonical=origin?new URL(withBase(canonicalPath),origin).href:undefined;
const nav=[['/','Home'],['/about/','About Michelle'],['/services/','Coaching services'],['/why-us/','Why Esperanza'],['/reviews/','Client stories'],['/contact/','Let’s connect']];
const current=(href:string)=>canonicalPath===href?'page':undefined;
---
<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width"/>
  <link rel="preload" href={withBase("/fonts/editorial.woff2")} as="font" type="font/woff2" crossorigin/>
  <link rel="preload" href={withBase("/fonts/editorial-italic.woff2")} as="font" type="font/woff2" crossorigin/>
  <link rel="preload" href={withBase("/fonts/dm-sans.woff2")} as="font" type="font/woff2" crossorigin/>
  <title>{title} | Esperanza Coaching Collective</title>
  <meta name="description" content={description}/>
  <meta name="robots" content={ready?'index, follow':'noindex, nofollow'}/>
  {canonical&&<link rel="canonical" href={canonical}/>}
  <meta property="og:title" content={`${title} | Esperanza Coaching Collective`}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/>
  {canonical&&<meta property="og:url" content={canonical}/>}
  <meta name="twitter:card" content="summary_large_image"/>
  {origin&&<meta property="og:image" content={new URL(withBase('/images/portrait.jpg'),origin).href}/>}
  <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml"/>
  {origin&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'Esperanza Coaching Collective',url:new URL(withBase('/'),origin).href,email:'info@esperanzacoachingcollective.com',telephone:'+1-407-721-5984'})}/>}
 </head>
 <body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
   <a href={withBase("/")} class="brand" aria-label="Esperanza Coaching Collective home"><Brand/></a>
   <nav class="desktop-nav" aria-label="Primary navigation">
    {[['/','Home'],['/about/','About'],['/services/','Services'],['/contact/','Contact']].map(([href,label])=><a href={withBase(href)} aria-current={current(href)}>{label}</a>)}
   </nav>
   <div class="header-actions"><div class="header-cta"><Booking label="Let’s talk"/></div>
    <button class="menu-toggle" aria-label="Menu" aria-controls="navigation-dialog" aria-expanded="false" hidden><span>Menu</span><span class="menu-icon" aria-hidden="true"><i></i><i></i></span></button>
   </div>
  </header>
  <noscript><nav class="nojs-navigation" aria-label="All pages">{nav.map(([href,label])=><a href={withBase(href)}>{label}</a>)}</nav></noscript>
  <dialog id="navigation-dialog" class="menu-dialog" aria-labelledby="menu-heading">
   <div class="menu-shell">
    <div class="menu-top"><a class="brand" href={withBase("/")} aria-label="Esperanza home"><Brand/></a><button class="menu-close" aria-label="Close menu"><span>Close</span><span class="menu-icon" aria-hidden="true"><i></i><i></i></span></button></div>
    <div class="menu-content"><div class="menu-aside"><p class="eyebrow" id="menu-heading">Find your way</p><p class="menu-message">A little hope.<br/>A way forward.<br/><em>Together.</em></p><p>Compassionate coaching for<br/>life’s uncertain chapters.</p><a href="mailto:info@esperanzacoachingcollective.com" class="menu-email">Get in touch <span aria-hidden="true">↗</span></a></div>
     <nav id="main-nav" aria-label="All pages">{nav.map(([href,label],i)=><a href={withBase(href)} aria-current={current(href)} style={`--link-index:${i}`}><span class="nav-index">0{i+1}</span><span>{label}</span><span class="nav-arrow" aria-hidden="true">↗</span></a>)}</nav>
    </div>
    <div class="menu-bottom"><span>English &amp; Español</span><a href={withBase("/free-guide/")}>Explore the free guide <span aria-hidden="true">↗</span></a><span>Esperanza Coaching Collective</span></div>
   </div>
  </dialog>
  <main id="main" tabindex="-1"><slot/></main>
  <section class="community section">
   <div class="community-heading"><span class="eyebrow">A community that understands</span><span class="chapter-mark" aria-hidden="true">e.</span></div>
   <div class="community-row"><h2>A shared path.<br/><em>A little less alone.</em></h2><div><p>Connect with other couples on the same journey. Share experiences, ask questions, and get weekly tips from Michelle — completely free.</p>{config.community?<a class="button light" href={config.community} target="_blank" rel="noopener noreferrer">Join our Facebook community <span aria-hidden="true">↗</span></a>:<a class="button light" href={withBase("/contact/#community")}>About the free community <span aria-hidden="true">↗</span></a>}</div></div>
  </section>
  <footer class="site-footer">
   <div class="footer-main"><div class="footer-brand"><a class="brand" href={withBase("/")} aria-label="Esperanza home"><Brand/></a><p>Compassionate coaching.<br/>A way forward, together.</p><span class="footer-language">English &amp; Español</span></div>
    <div class="footer-links"><p class="eyebrow">Explore</p>{nav.filter(([href])=>href!=='/').map(([href,label])=><a href={withBase(href)}>{label}</a>)}</div>
    <div class="footer-contact"><p class="eyebrow">A conversation is a beginning</p><a href="mailto:info@esperanzacoachingcollective.com">info@esperanzacoachingcollective.com</a><a href="tel:+14077215984">+1 407-721-5984</a><Booking/></div>
   </div>
   <div class="footer-resource"><p>A little clarity, <em>at your pace.</em></p><a class="text-link" href={withBase("/free-guide/")}>Explore your free guide <span aria-hidden="true">↗</span></a></div>
   <div class="footer-bottom"><span>© {new Date().getFullYear()} Esperanza Coaching Collective</span><a href={withBase("/privacy/")}>Privacy</a>{config.fjr?<a href={config.fjr} target="_blank" rel="noopener noreferrer">Website Designed &amp; Developed by FJR</a>:<span>Website Designed &amp; Developed by FJR</span>}</div>
  </footer>
  <script>import '../scripts/site';</script>
 </body>
</html>
