---
import {withBase} from '../utils/paths';
import Layout from '../layouts/Layout.astro';
import Booking from '../components/Booking.astro';
import FAQ from '../components/FAQ.astro';
import Botanical from '../components/Botanical.astro';
import {services,intro} from '../data/content';
---
<Layout title="Compassionate fertility & couples coaching" description="Compassionate, bilingual coaching with Michelle Savage for couples navigating infertility, grief and loss. Explore Esperanza Coaching Collective.">
 <section class="hero">
  <div class="hero-copy"><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> A space for hope. A space for you.</p><h1 class="hero-title">A little hope.<br/>A way <em>forward.</em></h1><p class="hero-description">Guiding couples through infertility, grief, and loss with compassionate coaching.</p><div class="hero-actions"><Booking/><a class="text-link" href={withBase("/services/")}>Find your support <span aria-hidden="true">↗</span></a></div><div class="hero-note"><Botanical/><p>Your story matters.<br/><span>Let’s take the next step, together.</span></p></div></div>
  <div class="hero-visual"><img src={withBase("/images/portrait.webp")} srcset={`${withBase("/images/portrait-small.webp")} 400w, ${withBase("/images/portrait.webp")} 715w`} sizes="(max-width: 700px) 100vw, 45vw" width="715" height="1024" alt="Michelle Savage smiling outdoors" fetchpriority="high"/><div class="portrait-intro"><div><span class="eyebrow">A human connection</span><p>Hi, I’m Michelle.</p><span>Coach &amp; Couples Therapist</span></div><a href={withBase("/about/")} aria-label="Meet Michelle Savage"><span aria-hidden="true">↗</span></a></div></div>
 </section>
 <div class="principles"><p>Support, with understanding.</p><span>Couples coaching</span><span>Autoimmune-informed</span><span>English &amp; Español</span></div>
 <section class="section introduction"><div class="section-kicker"><p class="eyebrow">01 / The Esperanza approach</p><span>A little more understanding</span></div><div class="intro-grid"><div><h2>You don’t have to<br/>figure it all out<br/><em>on your own.</em></h2><a class="text-link" href={withBase("/why-us/")}>Why Esperanza <span aria-hidden="true">↗</span></a></div><div class="intro-body"><p class="intro-subhead">Finding hope through your fertility journey.</p><p>{intro}</p><a class="text-link" href={withBase("/about/")}>Get to know Michelle <span aria-hidden="true">↗</span></a></div></div></section>
 <section class="section service-section"><div class="section-kicker"><p class="eyebrow">02 / Ways to work together</p><span>Thoughtful support. At your pace.</span></div><div class="section-heading"><h2>Where you are.<br/><em>What you need.</em></h2><p>Compassionate guidance and support for autoimmune couples navigating fertility challenges.</p></div><div class="service-list">{services.map((s,i)=><a class="service-row" href={withBase(`/services/#service-${i+1}`)}><span class="service-number">0{i+1}</span><div class="service-row-title"><span class="eyebrow">{['Understand your journey','Reconnect, together','Experience that understands'][i]}</span><h3>{s.title}</h3></div><p>{s.short}</p><span class="circle-arrow" aria-hidden="true">↗</span></a>)}</div><div class="section-end"><span>Support shaped around your journey.</span><a class="text-link" href={withBase("/services/")}>Explore all coaching services <span aria-hidden="true">↗</span></a></div></section>
 <section class="section story-section"><div class="story-copy"><p class="eyebrow">03 / From one journey to another</p><h2>“I know exactly<br/>how you feel —<br/><em>because I’ve<br/>been there.</em>”</h2><p>Hear Michelle share her own story and how she turned her journey into a mission to help couples like you.</p><a class="text-link" href={withBase("/about/")}>The story behind Esperanza <span aria-hidden="true">↗</span></a></div><div class="story-media"><div class="video-caption"><span>Michelle’s story</span><span>01:41</span></div><video controls preload="none" poster={withBase("/images/story-poster.webp")} width="1280" height="720" aria-label="Michelle shares her personal fertility journey"><source src={withBase("/images/story.mp4")} type="video/mp4"/>Your browser cannot play this video.</video><p class="caption-note">Original story video. Captions and transcript are pending verification.</p><div class="story-footnote"><Botanical/><p>Lived experience.<br/>Real understanding.</p></div></div></section>
 <FAQ/>
</Layout>
