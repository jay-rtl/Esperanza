---
import {withBase} from '../utils/paths';
import {faqs} from '../data/content';
---
<section class="section faq-section" id="questions"><div class="section-kicker"><p class="eyebrow">A little more clarity</p><span>There’s room for your questions.</span></div><div class="faq-layout"><div><h2>Honest questions.<br/><em>Thoughtful answers.</em></h2><p>Every journey is different.<br/>Let’s start with what’s on your mind.</p><a class="text-link" href={withBase("/contact/")}>Ask Michelle a question <span aria-hidden="true">↗</span></a></div><div class="faq-list">{faqs.map(([q,a],i)=><details><summary><span class="faq-num">0{i+1}</span><span>{q}</span><span class="plus" aria-hidden="true">+</span></summary><div class="faq-answer"><p>{a}</p></div></details>)}</div></div></section>
